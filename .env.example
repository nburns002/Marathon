# Export these values in the application process environment.
# Generate a stable secret with node:crypto for any non-demo environment.
JWT_SECRET=

# Optional local demo. Use a separate database for demo data.
DEMO_MODE=false

# Production: put the SQLite database on a persistent volume.
MARATHON_SQLITE_PATH=

# Optional alternate development/import JSON path. Defaults to ./marathon_db.json.
MARATHON_JSON_PATH=

# Set only to bootstrap an administrator on an empty database.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Explicitly import MARATHON_JSON_PATH when SQLite has no snapshot.
MARATHON_IMPORT_LEGACY_JSON=false

# Production defaults to same-origin API access. List extra exact browser origins only if needed.
ALLOWED_ORIGINS=

# Exact IPs of reverse proxies that overwrite forwarded headers. Empty means direct clients only.
TRUSTED_PROXY_IPS=

# Enable only when the public deployment is HTTPS-only.
ENABLE_HSTS=false
